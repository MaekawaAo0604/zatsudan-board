{
  "permissions": {
    "allow": [
      "Edit(/data/topics.json)",
      "Bash(bash .claude/skills/add-daily-topics/prepare-main.sh)",
      "Bash(date +%F)",
      "Bash(git status --short)",
      "Bash(node .claude/skills/add-daily-topics/validate.mjs data/topics.json)",
      "Bash(git checkout -- data/topics.json)",
      "Bash(bash .claude/skills/add-daily-topics/commit-today.sh)",
      "Bash(bash .claude/skills/add-daily-topics/push-today.sh *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests.sh\"",
            "timeout": 60,
            "statusMessage": "テストを実行中"
          }
        ]
      }
    ]
  }
}
