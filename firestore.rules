// Firestore のルール。Firebase コンソールの「Firestore Database」→「ルール」に、これと同じ文面を貼って公開している。
// このファイルを変えたら、コンソールにも貼り直す（ファイルを変えただけでは効かない）。
//
// 守っていること：
// - 印を作れるのは、ログインした本人の分だけ（他人の名前では作れない）
// - 消せるのは、自分の印だけ（他人の分を減らせない）
// - 印の形は決まった3項目だけで、ネタの id はその日の日付で始まる
// - 書き換え（update）はできない。付ける・取り消すは、作る・消すで行う
// 読み取りはだれでもできる（中身はネタの id と、ブラウザごとの匿名の id だけ）。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 「話したい」1件 = 1人が1つのネタに付けた印。数えるのは画面側
    match /votes/{voteId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['date', 'topicId', 'uid'])
        && request.resource.data.keys().hasAll(['date', 'topicId', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.topicId is string
        && request.resource.data.topicId.matches(request.resource.data.date + '-[0-9]{1,3}')
        && voteId == request.resource.data.topicId + '_' + request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
